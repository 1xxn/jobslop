{
  "manifest_version": 3,
  "name": "jobslop Assistent",
  "description": "Füllt Bewerbungsformulare in deinem eigenen Chrome mit deinem lokalen jobslop aus. Abgeschickt wird erst nach deinem Klick.",
  "version": "1.0.0",
  "action": {
    "default_title": "jobslop: dieses Formular ausfüllen"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
