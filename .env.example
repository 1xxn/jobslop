# Optional: nach .env kopieren (im Projektordner oder in ~/.jobpilot/.env).
# Ein API-Schlüssel wird NICHT gebraucht – jobpilot nutzt dein Claude-Abo über Claude Code (`claude` einmal starten und einloggen).

# JOBPILOT_HOME=~/.jobpilot
# JOBPILOT_LLM_MODEL=sonnet           # Formulare ausfüllen, Anschreiben (sonnet | opus | haiku)
# JOBPILOT_LLM_MODEL_FAST=haiku       # Stellen bewerten, Karriereseiten auslesen
# JOBPILOT_CLAUDE_BIN=                # leer = automatisch (PATH, ~/.local/bin/claude[.exe], npm)
# JOBPILOT_CLAUDE_PARALLEL=2          # gleichzeitige Claude-Aufrufe
# JOBPILOT_CLAUDE_TIMEOUT_S=300
# JOBPILOT_CLAUDE_EFFORT=             # optional: low | medium | high
# JOBPILOT_KEEP_LLM_WORKDIRS=false    # true = Prompts/Dateien der Aufrufe zum Debuggen behalten
# JOBPILOT_APPLY_MODE=review          # review | auto | dry-run
# JOBPILOT_VISION=auto                # auto | always | never (Screenshots an Claude)
# JOBPILOT_HEADLESS=false
