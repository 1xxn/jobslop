# Kopieren nach .env (im Projektordner oder in ~/.jobpilot/.env) und ausfüllen.
ANTHROPIC_API_KEY=sk-ant-...

# Optional – Standardwerte stehen daneben
# JOBPILOT_HOME=~/.jobpilot
# JOBPILOT_LLM_MODEL=claude-sonnet-5-5          # Formulare ausfüllen, Anschreiben
# JOBPILOT_LLM_MODEL_FAST=claude-haiku-5-5      # Stellen bewerten, Karriereseiten auslesen
# JOBPILOT_APPLY_MODE=review                    # review | auto | dry-run
# JOBPILOT_VISION=auto                          # auto | always | never (Screenshots an Claude)
# JOBPILOT_HEADLESS=false
