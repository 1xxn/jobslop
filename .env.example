# Optional – fast alles lässt sich im Dashboard unter Einstellungen ändern.
# Diese Datei nach .env kopieren (Projektordner oder ~/.jobslop/.env). Umgebungsvariablen haben Vorrang.
# Ein API-Schlüssel wird NICHT gebraucht: jobslop nutzt dein Claude-Abo über Claude Code.

# JOBSLOP_HOME=~/.jobslop             # Datenordner
# JOBSLOP_DASHBOARD_PORT=8765
# JOBSLOP_CLAUDE_BIN=                 # leer = automatisch (PATH, ~/.local/bin/claude[.exe], npm)
# JOBSLOP_LLM_MODEL=sonnet            # Formulare & Anschreiben (sonnet | opus | haiku)
# JOBSLOP_LLM_MODEL_FAST=haiku        # Bewertung & Karriereseiten
# JOBSLOP_CLAUDE_PARALLEL=2
# JOBSLOP_CLAUDE_TIMEOUT_S=300
# JOBSLOP_CLAUDE_EFFORT=              # optional: low | medium | high
# JOBSLOP_KEEP_LLM_WORKDIRS=false     # true = Prompts/Dateien der Claude-Aufrufe zum Debuggen behalten
# JOBSLOP_APPLY_MODE=review           # review | auto | dry-run
# JOBSLOP_VISION=auto                 # auto | always | never
# JOBSLOP_AUTOFILL=true
# JOBSLOP_HEADLESS=false
# JOBSLOP_NOTIFY_NTFY_URL=            # z. B. https://ntfy.sh/dein-geheimes-thema
# JOBSLOP_NOTIFY_WEBHOOK_URL=
